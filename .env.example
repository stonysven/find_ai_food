# ScrapeGraphAI API key
SCRAPEGRAPH_API_KEY=your_api_key_here
SCRAPEGRAPH_MODEL_PROVIDER=oneapi
SCRAPEGRAPH_MODEL=glm-5
SCRAPEGRAPH_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SCRAPEGRAPH_MODEL_TOKENS=128000
SCRAPEGRAPH_TIMEOUT_SECONDS=30

# Optional Obsidian vault path
OBSIDIAN_VAULT_PATH=

# Optional overrides, comma-separated
GITHUB_QUERIES=topic:rag stars:>300,topic:llm-agent stars:>200,mcp ai agent
YOUTUBE_QUERIES=LLM,Prompt,RAG,Agent,MCP,LangChain
BILIBILI_QUERIES=LLM,Prompt,RAG,Agent,MCP,LangChain
